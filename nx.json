{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      },
      "exclude": ["packages/docs/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      },
      "exclude": ["packages/lighthouse-soft-navigation-e2e/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "include": ["packages/lighthouse-soft-navigation-e2e/**/*"],
      "options": {
        "testTargetName": "e2e",
        "ciTargetName": "e2e-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/rolldown/plugin",
      "options": {
        "buildTargetName": "build"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "analytics": false,
  "release": {
    "projects": ["lighthouse-soft-navigation"],
    "version": {
      "preVersionCommand": "pnpm nx run-many -t build -p lighthouse-soft-navigation",
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    },
    "git": {
      "commitMessage": "chore(release): publish {version}"
    }
  },
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "neverConnectToCloud": true
}
